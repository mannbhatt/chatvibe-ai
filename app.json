{
  "expo": {
    "name": "ChatVibe AI",
    "slug": "chatvibeai",
    "scheme": "chatvibeai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chatvibeai.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "ChatVibe AI needs access to save your memes and creations to your photo library."
      }
    },
    "android": {
      "package": "com.chatvibeai.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#cff5e1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      "expo-font",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "ChatVibe AI needs access to save your memes and creations to your photo library.",
          "savePhotosPermission": "ChatVibe AI needs access to save your memes and creations to your photo library."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5911def6-4aad-4fba-b65a-28aedbb87320"
      }
    }
  }
}